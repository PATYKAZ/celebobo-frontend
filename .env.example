# --- API Django (Celebobo) -------------------------------------------------
# URL de base de l'API. Vide => mode MOCK (données locales, aucune requête réseau).
# Recommandé : /api/v1 + API_PROXY_TARGET (même origine, cookies first-party).
NEXT_PUBLIC_API_URL=/api/v1

# Force le mode mock même si NEXT_PUBLIC_API_URL est défini ("true" | "false")
NEXT_PUBLIC_USE_MOCKS=false

# Proxy (next.config.ts) : relaie /api/* vers le backend
API_PROXY_TARGET=http://localhost:8000

# WebSocket temps réel (non relayé par le proxy) : ws://localhost:8000/ws/
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/

# Hôte des médias servis par le backend (next/image)
NEXT_PUBLIC_MEDIA_HOST=

# Nom du cookie CSRF Django
NEXT_PUBLIC_CSRF_COOKIE=csrftoken

# Connexion Google (le secret reste côté backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3000/connexion/google

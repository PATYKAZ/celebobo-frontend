# --- API Django (Celebobo) -------------------------------------------------
# URL de base de l'API. Vide => mode MOCK (données locales, aucune requête réseau).
# Exemples :  http://localhost:8000/api   |   /api (avec API_PROXY_TARGET)
NEXT_PUBLIC_API_URL=

# Force le mode mock même si NEXT_PUBLIC_API_URL est défini ("true" | "false")
NEXT_PUBLIC_USE_MOCKS=true

# Proxy dev (next.config.ts) : redirige /api/* vers le backend
API_PROXY_TARGET=

# Hôte des médias servis par le backend (next/image)
NEXT_PUBLIC_MEDIA_HOST=

# Nom du cookie CSRF Django
NEXT_PUBLIC_CSRF_COOKIE=csrftoken

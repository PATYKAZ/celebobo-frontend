# --- API Django (Celebobo) -------------------------------------------------
# Développement recommandé : la stack locale du backend (./deploy/local.sh up) sert le site sur
# http://localhost:8080 ; nginx y route /api et /ws vers Django et le reste vers `npm run dev` (port 3000).
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_WS_URL=/ws/

# Proxy Next (next.config.ts) : seulement si le site n'est PAS ouvert via le nginx du backend
# (ex. http://localhost:3000 direct, ou front hébergé sur Vercel). Exemple : http://localhost:8080
API_PROXY_TARGET=

# Hôte des médias servis par le backend (next/image)
NEXT_PUBLIC_MEDIA_HOST=

# Nom du cookie CSRF Django
NEXT_PUBLIC_CSRF_COOKIE=csrftoken

# Connexion Google (le secret reste côté backend)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8080/connexion/google
